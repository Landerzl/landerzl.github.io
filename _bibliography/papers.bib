@unpublished{zulueta2026critical,
  abbr        = {Preprint},
  bibtex_show = {true},
  selected    = {true},
  title       = {Critical quantum metrology with the quantum Rabi model: Fisher information across the superradiant transition},
  author      = {Zulueta, Lander and Egusquiza, Iñigo and Apellaniz, Jagoba},
  year        = {2026},
  month       = {oct},
  abstract    = {Critical quantum metrology exploits the diverging susceptibility of systems near quantum phase transitions to surpass classical estimation limits. We show that the quantum Rabi model, a single qubit coupled to a single bosonic mode, provides such a resource in the classical oscillator limit, where the ratio of qubit to mode frequency plays the role of the thermodynamic limit. Using first- and second-order Schrieffer-Wolff effective Hamiltonians, we derive the quantum Fisher information (QFI) for the estimation of the coupling strength and show that it diverges with a critical exponent of −2 in the normal phase. In the superradiant phase, where the effective potential inverts and standard methods fail, we introduce a displaced and squeezed Fock-basis scheme that restores numerical convergence, and we obtain the QFI of the physical ground state by accounting for the coupling dependence of the basis transformation. The entanglement entropy peaks at the critical point, providing an independent signature of the transition.},
  pdf         = {critical_metrology_zulueta.pdf},
  code        = {https://github.com/Landerzl/Critical-Metrology},
  preview     = {critical_metrology.png}
}
